/vehicle-command

# Gradle / Kotlin
.gradle/
build/
.kotlin/
local.properties
*.iml
.idea/

# Xcode / iOS
xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/
Pods/

# macOS
.DS_Store

# Secrets / local keys used in real-vehicle testing
*.pem
!**/src/*Test/resources/**/*.pem
*.key
.env

# Kotlin / Gradle (M0)
.kotlin/
**/build/
# XcodeGen generates the project; only project.yml is tracked
samples/ios/*.xcodeproj/
# XcodeGen regenerates Info.plist from project.yml's `info:` block on every `xcodegen generate`
samples/ios/Sources/Info.plist
