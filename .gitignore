# Reference: official Tesla Go SDK (https://github.com/teslamotors/vehicle-command)
# Read-only local clone used as porting source. Never commit.
/vehicle-command

# Gradle / Kotlin
.gradle/
build/
.kotlin/
local.properties
*.iml
.idea/

# Xcode / iOS
xcuserdata/
DerivedData/
*.xcworkspace/xcuserdata/
Pods/
samples/ios/Local.xcconfig

# macOS
.DS_Store

# Secrets / local keys used in real-vehicle testing
*.pem
*.key
.env

# Kotlin / Gradle (M0)
.kotlin/
**/build/
# XcodeGen generates the project; only project.yml is tracked
samples/ios/*.xcodeproj/
# XcodeGen regenerates Info.plist from project.yml's `info:` block on every `xcodegen generate`
samples/ios/Sources/Info.plist

# Golden capture output (real vehicle data; never commit)
tools/fixtures/captures/

# Monitor logs pulled from devices (real vehicle data; never commit)
samples/logs/

# Release artifacts from tools/release/build-xcframework.sh (ADR-0017): the checksummed zip is uploaded as is, never committed
build/release/

# SwiftPM and Xcode output once tools/release/prepare.sh puts Package.swift at the repository root (ADR-0017)
.build/
.swiftpm/
